# .env.template - Variables d'environnement

# ===========================================
# CONFIGURATION DJANGO
# ===========================================
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ===========================================
# BASE DE DONNÉES
# ===========================================
# Pour SQLite (développement)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Pour PostgreSQL (production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=transport_system
# DB_USER=postgres
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# ===========================================
# REDIS (CACHE ET WEBSOCKETS)
# ===========================================
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# EMAIL
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@transportpro.ma

# ===========================================
# API KEYS (OPTIONNEL)
# ===========================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
OPENWEATHERMAP_API_KEY=your-openweather-api-key
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key

# ===========================================
# SÉCURITÉ (PRODUCTION)
# ===========================================
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ===========================================
# MONITORING (OPTIONNEL)
# ===========================================
# SENTRY_DSN=your-sentry-dsn